{
  // Cloudflare publishes the "site" folder as the Rhead Home app.
  // worker/index.js only answers /api/* (bank sync with Plaid); everything else is the app.
  "name": "rhead-home",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Pull new bank transactions 4 times a day (about 7am, 11am, 3pm, 7pm New York time).
  "triggers": { "crons": ["17 0,12,16,20 * * *"] },
  // Keep secrets/variables added in the Cloudflare dashboard.
  "keep_vars": true
}
